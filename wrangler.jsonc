{
  "name": "ncu-gym-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncu-gym",
      "database_id": "751135a2-8940-4133-bf06-4dfd568e1dcc",
      "migrations_dir": "migrations"
    }
  ]
}
